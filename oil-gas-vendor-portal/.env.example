# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:password@localhost:5432/oilandgas

# ── AI / LLM ─────────────────────────────────────────────────────
# Ollama local LLM server (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# ── Vector DB ────────────────────────────────────────────────────
# ChromaDB for RAG document retrieval (default: http://localhost:8000)
CHROMA_URL=http://localhost:8000

# ── Session ───────────────────────────────────────────────────────
# Secret for signing session cookies (generate: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-random-64-char-secret

# ── Data ─────────────────────────────────────────────────────────
# Path to Kaggle datasets (for jobs that read CSV files)
DATA_BASE_PATH=/mnt/deepa/IoT/code/oil-gas-monitoring

# ── Email / Notifications ─────────────────────────────────────────
# SMTP for sending notifications (optional — notifications queued if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@oilandgas.local

# ── Feature Flags ─────────────────────────────────────────────────
# Set to 'true' to enable experimental features
ENABLE_EXPERIMENTAL=false
NODE_ENV=development
